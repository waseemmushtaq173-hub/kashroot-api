{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": false,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "seed",
    "**/*.spec.ts",
    "src/modules/appointments",
    "src/modules/admin",
    "src/modules/chat",
    "src/modules/disputes",
    "src/modules/notifications",
    "src/modules/realtime",
    "src/modules/orders/payments.service.ts",
    "src/modules/orders/pricing-snapshot.service.ts",
    "src/modules/orders/ledger.service.ts",
    "src/modules/orders/region-pair-enablement.service.ts",
    "src/modules/listings/inventory-reservations.service.ts",
    "src/modules/listings/queues/reservation-expiry.processor.ts"
  ]
}