# ============================================================
# KashRoot API — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://kashroot:password@localhost:5432/kashroot_db

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=CHANGE_ME_min_64_chars_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_min_64_chars_random_string
JWT_REFRESH_EXPIRES_IN=30d

# --- MFA ---
TOTP_ISSUER=KashRoot

# --- Argon2 ---
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# --- OTP ---
OTP_EXPIRY_MINUTES=10

# --- Google OAuth (buyers only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth/google/callback

# --- AWS / S3-compatible Storage ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_UPLOADS=kashroot-uploads-dev
S3_ENDPOINT=  # Leave blank for AWS; set for MinIO/Cloudflare R2

# --- Stripe (international) ---
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# --- Razorpay (domestic India) ---
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SendGrid (email) ---
SENDGRID_API_KEY=SG.
SENDGRID_FROM_EMAIL=noreply@kashroot.com
SENDGRID_FROM_NAME=KashRoot

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1

# --- AI Assistant: LLM (text generation) ---
LLM_PROVIDER=openai            # openai | gemini
LLM_API_KEY=                   # provider API key; blank => offline grounded router is used
LLM_MODEL=gpt-4o-mini          # e.g. gpt-4o-mini (OpenAI) or gemini-1.5-flash (Gemini)
LLM_API_URL=                   # optional base URL override (self-hosted / proxy / Azure)

# --- AI Assistant: Bhashini (speech-to-text + text-to-speech) ---
BHASHINI_API_KEY=              # Bhashini inference key; blank => offline STT/TTS stand-ins are used
BHASHINI_ASR_URL=              # ASR compute endpoint (drop in when provisioned)
BHASHINI_TTS_URL=              # TTS compute endpoint (drop in when provisioned)

# --- Rate Limiting ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Encryption (KYC docs at rest) ---
ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_encoded_key

# --- Sentry ---
SENTRY_DSN=

# --- Live mandi feed (Agmarknet) ---
# Base URL of the upstream daily-price feed used by GET /api/v1/mandi.
#   Blank  => the public keyless Mandi Price API mirror is used. It covers only
#             Punjab, Maharashtra, Uttar Pradesh, Madhya Pradesh and Karnataka,
#             so every other hub in the catalogue is served by the simulated
#             provider and reported as such on the response.
#   Set    => must expose /prices and /prices/history in the shape
#             AgmarknetProvider expects. Point this at data.gov.in (which needs
#             a key) or at your own cache to widen live coverage.
MANDI_API_BASE_URL=
