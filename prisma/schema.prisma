// ============================================================
// ESCROW & IMMUTABLE LEDGER
// ============================================================
// Financial integrity design:
//   - escrow_holds tracks money parked in the virtual vault per order and its
//     terminal disposition (released to provider / refunded to buyer).
//   - ledger_entries is an APPEND-ONLY audit log: no updated_at, no deleted_at.
//     Corrections are new offsetting entries, never mutations (see LedgerService).
// FK columns are intentionally plain scalars (not Prisma relations) so the
// ledger stays a self-contained financial record, decoupled from profile/order
// row lifecycles — a deleted order must never orphan or cascade its audit trail.

enum EscrowStatus {
  HELD // funds secured in the vault, awaiting outcome
  RELEASED // paid out to the provider/seller on completion
  REFUNDED // returned to the buyer (dispute / cancellation)

  @@map("escrow_status")
}

enum LedgerEntryType {
  CREDIT
  DEBIT

  @@map("ledger_entry_type")
}

model EscrowHold {
  id              String       @id @default(uuid())
  orderId         String       @unique @map("order_id") // one active hold per order
  buyerProfileId  String       @map("buyer_profile_id")
  farmerProfileId String       @map("farmer_profile_id")
  amount          Decimal      @db.Decimal(12, 4)
  currency        String
  status          EscrowStatus @default(HELD)
  relatedRefundId String?      @map("related_refund_id")
  heldAt          DateTime     @default(now()) @map("held_at")
  releasedAt      DateTime?    @map("released_at")
  refundedAt      DateTime?    @map("refunded_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([farmerProfileId])
  @@index([buyerProfileId])
  @@map("escrow_holds")
}

// APPEND-ONLY. No updated_at / deleted_at by design — see LedgerService.
model LedgerEntry {
  id              String          @id @default(uuid())
  entryType       LedgerEntryType @map("entry_type")
  amount          Decimal         @db.Decimal(12, 4)
  currency        String
  farmerProfileId String?         @map("farmer_profile_id")
  buyerProfileId  String?         @map("buyer_profile_id")
  relatedOrderId  String?         @map("related_order_id")
  relatedRefundId String?         @map("related_refund_id")
  description     String
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([relatedOrderId, createdAt])
  @@index([farmerProfileId, createdAt])
  @@index([buyerProfileId, createdAt])
  @@map("ledger_entries")
}

// ============================================================
// AGROGUARD — COUNTERFEIT PESTICIDE / INSECTICIDE TESTING
// ============================================================
// Field testers (Horticulture Dept / QC labs) scan agency-sold bottles
// (e.g. "Superstar" apple spray) and compare them against a curated
// industry "golden reference" to flag suspected counterfeits.

enum InspectionVerdict {
  GENUINE_FACTORY
  SUSPICIOUS_COUNTERFEIT

  @@map("inspection_verdict")
}

model TesterProfile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  organization String // e.g. "Horticulture Department / Quality Control Lab"
  badgeNumber  String?  @map("badge_number")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inspections AgencyPesticideInspection[]

  @@map("tester_profiles")
}

model IndustryGoldenReference {
  id                     String   @id @default(uuid())
  brandName              String   @unique @map("brand_name") // e.g. "Superstar"
  manufacturerName       String   @map("manufacturer_name") // e.g. "FIL Industries"
  chemicalComposition    String   @map("chemical_composition")
  targetCrops            String   @map("target_crops") // e.g. "Apple"
  factoryBatchPrefix     String   @map("factory_batch_prefix") // authentic batch prefix
  factoryHologramPattern String   @map("factory_hologram_pattern")
  goldenImageUrl         String   @map("golden_image_url")
  dosageInstructions     String   @map("dosage_instructions") // e.g. "1-1.5 ml/L for leaf vigour"
  audioPrompts           Json?    @map("audio_prompts") // spoken dosage per language
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("industry_golden_references")
}

model AgencyPesticideInspection {
  id                    String            @id @default(uuid())
  testerProfileId       String            @map("tester_profile_id")
  agencyName            String            @map("agency_name") // local shop / dealer
  productBrand          String            @map("product_brand") // e.g. "Superstar"
  scannedBatchNo        String?           @map("scanned_batch_no")
  scannedBottleImageUrl String            @map("scanned_bottle_image_url")
  verdict               InspectionVerdict
  matchConfidence       Float             @map("match_confidence") // 0..1
  discrepancyReport     Json?             @map("discrepancy_report") // { logoMismatch, fontMismatches, missingSeal, unlistedBatch }
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  testerProfile TesterProfile @relation(fields: [testerProfileId], references: [id], onDelete: Cascade)

  @@index([testerProfileId, createdAt])
  @@index([productBrand])
  @@map("agency_pesticide_inspections")
}

// ============================================================
// SPOKEN AGRONOMY KNOWLEDGE BASE
// ============================================================
// Research-backed farming advisories (spray schedules, pest control, modern
// orchard tech) surfaced in the Farmer Portal and grounded into the Voice AI
// assistant, with pre-rendered TTS clips per language.

enum AdvisoryCategory {
  SPRAY_SCHEDULE
  DISEASE_PEST
  FERTILIZER_SOIL
  MODERN_TECH
  GOV_ALERT

  @@map("advisory_category")
}

model FarmingAdvisory {
  id                 String           @id @default(uuid())
  topic              String // e.g. "Apple Scab Spray Schedule"
  category           AdvisoryCategory
  content            String // concise agronomy guidance
  applicableCrops    String[]         @map("applicable_crops")
  applicableRegions  String[]         @map("applicable_regions")
  isGovVerified      Boolean          @default(false) @map("is_gov_verified")
  sourceOrganization String           @map("source_organization") // e.g. "SKUAST-Kashmir", "ICAR"
  sourceUrl          String?          @map("source_url") // link to the official mandate
  audioPrompts       Json?            @map("audio_prompts") // pre-rendered TTS per language
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([category])
  @@index([isGovVerified, updatedAt])
  @@map("farming_advisories")
}

